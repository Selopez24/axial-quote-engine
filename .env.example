DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quote_engine

# Required only for the real-LLM integration tests (tests/test_integration_llm.py).
# Without it those tests skip and the deterministic suite still passes.
# OPENAI_API_KEY=***
# QUOTE_ENGINE_MODEL=gpt-6-luna   # default; set to gpt-4o-mini for the legacy shape

# Option B: run the real-model tests through an OpenCode Go subscription instead
# of a direct OpenAI key. The Go gateway serves the same Responses API, but its
# catalog has no gpt-4o-mini, so pick a model from its /v1/responses endpoint
# (gpt-6-luna or gpt-5.6-luna). Put the OpenCode key in OPENAI_API_KEY.
# OPENAI_API_KEY=<your-…-key>
# OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# QUOTE_ENGINE_MODEL=gpt-6-luna

# Seed the assignment's Phase 1 scenario on startup (for demos/reviewer convenience).
# Set to 1 to load db/scenario_phase1.json through the pipeline automatically.
# SEED_SCENARIO=0
